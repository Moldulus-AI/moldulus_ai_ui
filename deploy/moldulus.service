[Unit]
Description=Moldulus web app (Next.js)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=moldulus
Group=moldulus
WorkingDirectory=/opt/moldulus
EnvironmentFile=/opt/moldulus/.env.production
Environment=NODE_ENV=production
# Listen on localhost only; nginx is the public entry point.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
