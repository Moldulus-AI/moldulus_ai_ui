# Copy to .env.local (or .env.production) and adjust.

# Where Ollama is listening. Keep it on localhost - never expose 11434 publicly.
OLLAMA_URL=http://127.0.0.1:11434

# Main chat model. Pick by hardware (see DEPLOY.md):
#   qwen3.5:4b  -> small servers / CPU-only (fast, lower quality)
#   qwen3.5:9b  -> recommended default (~6.6 GB download, text + image input)
#   qwen3:8b    -> older but very widely tested fallback (text only)
#   qwen3.5:27b -> 24 GB GPU, noticeably smarter
OLLAMA_MODEL=qwen3.5:9b

# Model used when the user attaches an image (must be vision-capable).
# qwen3.5 models understand images natively, so this can be the same model.
# Leave empty to disable image attachments (e.g. if you use qwen3:8b).
OLLAMA_VISION_MODEL=qwen3.5:9b

# Qwen3 / DeepSeek-R1 style models "think" before answering, which is slow for chat.
# false = answer directly (fast). true = show deeper reasoning (slower).
# Remove this line entirely if you switch to a model that has no thinking mode.
OLLAMA_THINK=false

# Context window in tokens. Bigger = remembers more but uses more RAM/VRAM.
OLLAMA_NUM_CTX=8192

# How long Ollama keeps the model loaded in memory after the last request.
OLLAMA_KEEP_ALIVE=30m

# Sampling temperature (0 = focused, 1 = creative)
OLLAMA_TEMPERATURE=0.6

# Abuse protection: max chat requests per IP per minute
RATE_LIMIT_PER_MIN=20
